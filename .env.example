# Copy to .env and fill in. Never commit .env.

# --- Django -----------------------------------------------------------------
DJANGO_DEBUG=1                        # 0 in production
DJANGO_SECRET_KEY=change-me           # required when DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kolkata                # used for year / month bucketing
HTTPS_ONLY=                           # defaults to on when DJANGO_DEBUG=0; set 0 to try Docker over http://localhost

# --- Infrastructure -----------------------------------------------------------
DATABASE_URL=postgres://prtracker:prtracker@localhost:5432/prtracker
REDIS_URL=redis://localhost:6379/0
CELERY_EAGER=0                        # 1 = run background jobs inline (no Redis/worker needed)

# The URL you open in the browser (Vite dev server locally, your domain in production).
# OAuth callbacks and the webhook URL are derived from it.
PUBLIC_URL=http://localhost:5173
# Where the Vite dev proxy forwards /api (frontend/vite.config.js).
# VITE_BACKEND_URL=http://localhost:8000

# --- GitHub App (required) -------------------------------------------------------
# One App, installed by each organization. Create at https://github.com/settings/apps/new - see README "GitHub setup".
# The private key is a secret: keep it in the environment / a secret manager, never in the repo.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY_PATH=              # path to the downloaded .pem, or use GITHUB_PRIVATE_KEY (\n-escaped)
GITHUB_PRIVATE_KEY=
GITHUB_CLIENT_ID=                     # the App's client ID (used only to sign users in)
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=                # the same value you set on the App's webhook

# --- Slack (optional) --------------------------------------------------------------
# A Slack App with bot scopes chat:write, im:write, users:read, users:read.email. See README "Slack setup".
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_BASE=                  # https origin for Slack's redirect (e.g. your ngrok URL); defaults to PUBLIC_URL
SECRETS_ENCRYPTION_KEY=               # optional Fernet key for stored Slack tokens; derived from DJANGO_SECRET_KEY if empty

# --- Optional ---------------------------------------------------------------------
ALLOW_DEMO_LOGIN=0                    # one-click demo user (python manage.py seed_demo). Never in production.
RECONCILE_INTERVAL_HOURS=6
IMPORT_BATCH_SIZE=25
